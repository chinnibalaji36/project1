# Flask
FLASK_SECRET_KEY=change-this-to-a-random-secret-key
FLASK_DEBUG=True

# Flipkart review fetching (optional).
# This project does NOT ship a hard-coded/invented Flipkart API.
# If you have access to a legitimate product-review data API (for example,
# a RapidAPI listing that provides Flipkart product data), put its
# credentials here. If left blank, the app will simply tell the user that
# automatic fetching is unavailable and ask them to enter reviews manually.
FLIPKART_API_KEY=
FLIPKART_API_HOST=
FLIPKART_API_URL=

# SQLite database path
DATABASE_PATH=database/reviews.db
